{
  "name": "@proyav/prozorro",
  "version": "0.1.0",
  "description": "MCP-сервер до відкритих даних Prozorro: пошук закупівель, картка процедури, стрічка змін",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepare": "tsc",
    "smoke": "node scripts/smoke.mjs",
    "test": "npm run build && node --test test/*.test.ts",
    "test:contract": "npm run build && node --test test/live/*.test.ts",
    "crawl": "npm run build && node dist/cli.js crawl",
    "index:stats": "node dist/cli.js stats",
    "serve": "npm run build && node dist/serve.js",
    "smoke:http": "npm run build && node scripts/smoke-http.mjs"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^7.0.2"
  },
  "bin": {
    "proyav-prozorro": "dist/index.js",
    "proyav-prozorro-serve": "dist/serve.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  }
}
